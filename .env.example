VITE_PUBLIC_APP_URL=http://localhost:3000
VITE_PUBLIC_BACKEND_URL=http://localhost:8787

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zerodotemail"

# Change this to a random string, for example: `openssl rand -hex 32`
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

COOKIE_DOMAIN="localhost"

# Optional: required only if you want to connect a real Gmail account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenRouter is the only LLM provider used by this fork
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite-preview-09-2025

# Local Redis / Upstash-compatible HTTP proxy
REDIS_URL="http://localhost:8079"
REDIS_TOKEN="upstash-local-token"

NODE_ENV="local"

# FOR PLAYWRIGHT E2E TESTING
PLAYWRIGHT_EMAIL=owner@local.test
PLAYWRIGHT_PASSWORD=ZeroHassle123!
EMAIL=owner@local.test
